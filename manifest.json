{
  "manifest_version": 3,
  "name": "TransLens — область в перевод",
  "version": "0.1.0",
  "description": "Выделяешь область на странице: OCR распознаёт текст и переводит его встроенным переводчиком Chrome. Всё офлайн, без ключей.",
  "minimum_chrome_version": "138",
  "permissions": ["activeTab", "scripting", "storage", "offscreen", "contextMenus"],
  "background": { "service_worker": "src/background.js", "type": "module" },
  "action": {
    "default_title": "Перевести область (Alt+Shift+S)",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png" }
  },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "commands": {
    "start-selection": {
      "suggested_key": { "default": "Alt+Shift+S", "mac": "Alt+Shift+S" },
      "description": "Выделить область для перевода"
    }
  },
  "options_page": "src/options.html",
  "content_security_policy": { "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'" }
}
